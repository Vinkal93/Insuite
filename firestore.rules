rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isOrgMember(orgId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function isOrgOwner(orgId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role in ["OWNER", "ADMIN", "PRINCIPAL"];
    }

    // User profiles
    match /users/{uid} {
      allow read, write: if isUser(uid);
    }

    // Organizations collection
    match /organizations/{orgId} {
      allow create: if isAuthenticated();
      allow read: if isOrgMember(orgId);
      allow update: if isOrgOwner(orgId);
      allow delete: if false;

      // Organization Members
      match /members/{memberUid} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgOwner(orgId) || (isAuthenticated() && request.auth.uid == memberUid);
      }

      // Academic Sessions
      match /academicSessions/{sessionId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgOwner(orgId);
      }

      // Students
      match /students/{studentId} {
        allow read, write: if isOrgMember(orgId);

        // Student Documents
        match /documents/{docId} {
          allow read, write: if isOrgMember(orgId);
        }
      }

      // Parents
      match /parents/{parentId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Counters (Sequence generation)
      match /counters/{counterId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Audit Logs
      match /auditLogs/{logId} {
        allow read, write: if isOrgMember(orgId);
      }
    }

    // Collection Group Queries for membership lookup
    match /{path=**}/members/{memberUid} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
