rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isOrgMember(orgId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function isOrgOwner(orgId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role in ["OWNER", "ADMIN", "PRINCIPAL"]) ||
        (exists(/databases/$(database)/documents/organizations/$(orgId)) &&
         get(/databases/$(database)/documents/organizations/$(orgId)).data.createdBy == request.auth.uid) ||
        isOrgMember(orgId)
      );
    }

    // User profiles
    match /users/{uid} {
      allow read, write: if isUser(uid);
    }

    // Organizations collection
    match /organizations/{orgId} {
      allow create: if isAuthenticated();
      allow read: if isOrgMember(orgId);
      allow update: if isAuthenticated() && (isOrgOwner(orgId) || resource.data.createdBy == request.auth.uid || isOrgMember(orgId));
      allow delete: if false;

      // Organization Members
      match /members/{memberUid} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgOwner(orgId) || (isAuthenticated() && request.auth.uid == memberUid);
      }

      // Academic Sessions
      match /academicSessions/{sessionId} {
        allow read, write: if isOrgMember(orgId) || isOrgOwner(orgId);
      }

      // Classes & Sections
      match /classes/{classId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /sections/{sectionId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Subjects & Mappings
      match /subjects/{subjectId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /classSubjectMappings/{mappingId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Teachers & Faculty
      match /teachers/{teacherId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Assignments
      match /classTeacherAssignments/{assignmentId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /subjectTeacherAssignments/{assignmentId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Academic Settings
      match /academicSettings/{settingId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Students & Documents
      match /students/{studentId} {
        allow read, write: if isOrgMember(orgId);
        match /documents/{docId} {
          allow read, write: if isOrgMember(orgId);
        }
      }

      // Parents
      match /parents/{parentId} {
        allow read, write: if isOrgMember(orgId);
        match /settings/{settingId} {
          allow read, write: if isOrgMember(orgId);
        }
      }

      // Admissions & CRM Modules
      match /enquiries/{enquiryId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /followUps/{followUpId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /counselling/{counsellingId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /applications/{applicationId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /admissions/{admissionId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /admissionSettings/{settingId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /admissionWaitlist/{waitlistId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /admissionCampaigns/{campaignId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Attendance & Roll Call
      match /attendance/{attendanceId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /leaveRequests/{leaveId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /attendanceSettings/{settingId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /attendanceAuditLogs/{logId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Timetable & Scheduling
      match /timetableEntries/{entryId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /rooms/{roomId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /periods/{periodId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /substitutions/{substitutionId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /timetableSettings/{settingId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Academic Work (Homework, Classwork, Submissions, Resources)
      match /assignments/{assignmentId} {
        allow read, write: if isOrgMember(orgId);

        match /submissions/{submissionId} {
          allow read, write: if isOrgMember(orgId);
        }
      }

      match /academicResources/{resourceId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Fees & Finance Management (Phase 9)
      match /feeStructures/{structureId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /feeInvoices/{invoiceId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /feePayments/{paymentId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /discounts/{discountId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /feeSettings/{settingId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Counters (Sequence generation)
      match /counters/{counterId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Phase 10: Examination Collections
      match /exams/{examId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /examSchedules/{scheduleId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /examSubjects/{subjectId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /marks/{markId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /results/{resultId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /gradingScales/{scaleId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /examSettings/{settingId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Phase 11: Communication Collections
      match /announcements/{announcementId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /notices/{noticeId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /communicationMessages/{messageId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /communicationTemplates/{templateId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /notifications/{notificationId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /communicationHistory/{historyId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /communicationSettings/{settingId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /userNotificationPreferences/{userId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Phase 12: Staff & HR Collections
      match /staff/{staffId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /departments/{departmentId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /designations/{designationId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /salaryStructures/{structureId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /staffSalaryProfiles/{staffId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /payroll/{payrollId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /hrSettings/{settingId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Phase 13: Library Management Collections
      match /libraryBooks/{bookId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /libraryBookCopies/{copyId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /libraryCategories/{categoryId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /libraryAuthors/{authorId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /libraryPublishers/{publisherId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /libraryTransactions/{transactionId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /libraryReservations/{reservationId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /libraryFines/{fineId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /librarySettings/{settingId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Phase 14: Transport Collections
      match /transportVehicles/{vehicleId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /transportRoutes/{routeId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /transportStops/{stopId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /transportDrivers/{driverId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /transportAssignments/{assignmentId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /transportTrips/{tripId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /transportMaintenance/{maintenanceId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /transportSettings/{settingId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Phase 15: Inventory & Assets Collections
      match /inventoryItems/{itemId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /inventoryAssets/{assetId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /inventoryCategories/{categoryId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /inventoryMovements/{movementId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /inventoryAssignments/{assignmentId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /inventoryTransfers/{transferId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /inventoryVendors/{vendorId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /purchaseOrders/{orderId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /inventoryMaintenance/{maintenanceId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /inventoryLocations/{locationId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /inventorySettings/{settingId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Phase 18: Student Portal Collections
      match /assignmentSubmissions/{submissionId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /studentAccounts/{studentId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Phase 20: PTM Collections
      match /ptmEvents/{eventId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /ptmSlots/{slotId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /ptmAppointments/{appointmentId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /ptmAvailability/{availabilityId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /ptmSettings/{settingId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /ptmMeetingNotes/{noteId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Phase 21: Certificates & Documents Collections
      match /issuedDocuments/{docId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /documentTemplates/{templateId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /documentTypes/{typeId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /documentJobs/{jobId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /documentSettings/{settingId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Phase 22: Front Office Collections
      match /frontOfficeVisitors/{visitorId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /frontOfficeVisits/{visitId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /frontOfficeGatePasses/{passId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /frontOfficeAppointments/{appointmentId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /frontOfficeCalls/{callId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /frontOfficeCorrespondence/{correspondenceId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /frontOfficeTasks/{taskId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /frontOfficeSettings/{settingId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Phase 23: Hostel Management Collections
      match /hostels/{hostelId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /hostelBuildings/{buildingId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /hostelFloors/{floorId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /hostelRooms/{roomId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /hostelBeds/{bedId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /hostelAllocations/{allocationId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /hostelAttendance/{attendanceId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /hostelLeaveRequests/{requestId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /hostelComplaints/{complaintId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /hostelMaintenance/{maintenanceId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /hostelSettings/{settingId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Audit Logs
      match /auditLogs/{logId} {
        allow read, write: if isOrgMember(orgId);
      }
    }

    // Collection Group Queries for membership lookup
    match /{path=**}/members/{memberUid} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.uid;
      allow write: if isSuperAdmin();
    }

    // Collection Group Queries for public certificate verification
    match /{path=**}/issuedDocuments/{docId} {
      allow read: if true;
    }

    // Collection Group Queries for public gate pass verification
    match /{path=**}/frontOfficeGatePasses/{passId} {
      allow read: if true;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
