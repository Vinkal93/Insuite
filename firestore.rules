rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isOrgMember(orgId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function isOrgOwner(orgId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role in ["OWNER", "ADMIN", "PRINCIPAL"];
    }

    // User profiles
    match /users/{uid} {
      allow read, write: if isUser(uid);
    }

    // Organizations collection
    match /organizations/{orgId} {
      allow create: if isAuthenticated();
      allow read: if isOrgMember(orgId);
      allow update: if isOrgOwner(orgId);
      allow delete: if false;

      // Organization Members
      match /members/{memberUid} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgOwner(orgId) || (isAuthenticated() && request.auth.uid == memberUid);
      }

      // Academic Sessions
      match /academicSessions/{sessionId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgOwner(orgId);
      }

      // Classes & Sections
      match /classes/{classId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /sections/{sectionId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Subjects & Mappings
      match /subjects/{subjectId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /classSubjectMappings/{mappingId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Teachers & Faculty
      match /teachers/{teacherId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Assignments
      match /classTeacherAssignments/{assignmentId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /subjectTeacherAssignments/{assignmentId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Academic Settings
      match /academicSettings/{settingId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Students & Documents
      match /students/{studentId} {
        allow read, write: if isOrgMember(orgId);
        match /documents/{docId} {
          allow read, write: if isOrgMember(orgId);
        }
      }

      // Parents
      match /parents/{parentId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Admissions & CRM Modules
      match /enquiries/{enquiryId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /followUps/{followUpId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /counselling/{counsellingId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /applications/{applicationId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /admissions/{admissionId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /admissionSettings/{settingId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Attendance & Roll Call
      match /attendance/{attendanceId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /leaveRequests/{leaveId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /attendanceSettings/{settingId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /attendanceAuditLogs/{logId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Timetable & Scheduling
      match /timetableEntries/{entryId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /rooms/{roomId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /periods/{periodId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /substitutions/{substitutionId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /timetableSettings/{settingId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Academic Work (Homework, Classwork, Submissions, Resources)
      match /assignments/{assignmentId} {
        allow read, write: if isOrgMember(orgId);

        match /submissions/{submissionId} {
          allow read, write: if isOrgMember(orgId);
        }
      }

      match /academicResources/{resourceId} {
        allow read, write: if isOrgMember(orgId);
      }

      match /academicWorkSettings/{settingId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Counters (Sequence generation)
      match /counters/{counterId} {
        allow read, write: if isOrgMember(orgId);
      }

      // Audit Logs
      match /auditLogs/{logId} {
        allow read, write: if isOrgMember(orgId);
      }
    }

    // Collection Group Queries for membership lookup
    match /{path=**}/members/{memberUid} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
